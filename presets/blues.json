{
  "name": "Texas Blues",
  "description": "Dynamic vintage overdrive with crunch tube amp voicing and slapback delay.",
  "effects": {
    "amp_sim": {
      "bass": 0.5,
      "enabled": true,
      "gain": 0.55,
      "mid": 0.65,
      "treble": 0.6,
      "voicing": 1
    },
    "delay": {
      "enabled": true,
      "feedback": 0.2,
      "mix": 0.18,
      "time_ms": 130.0
    },
    "distortion": {
      "drive": 0.4,
      "enabled": false,
      "level": 0.7,
      "tone": 0.5
    },
    "eq": {
      "enabled": true,
      "high_db": 1.5,
      "low_db": 2.0,
      "mid_db": 3.0
    },
    "input_gain": {
      "enabled": true,
      "gain_db": 2.0
    },
    "limiter": {
      "ceiling_db": -0.3,
      "enabled": true
    },
    "noise_gate": {
      "enabled": true,
      "threshold_db": -50.0
    },
    "overdrive": {
      "drive": 0.35,
      "enabled": true,
      "level": 0.85,
      "tone": 0.55
    },
    "reverb": {
      "decay": 0.4,
      "damping": 0.4,
      "enabled": true,
      "mix": 0.2
    }
  }
}
