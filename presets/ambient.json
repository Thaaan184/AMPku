{
  "name": "Lush Ambient",
  "description": "Dreamy spatial textures with long stereo ping-pong delay and cathedral reverb.",
  "effects": {
    "amp_sim": {
      "bass": 0.45,
      "enabled": true,
      "gain": 0.25,
      "mid": 0.6,
      "treble": 0.65,
      "voicing": 0
    },
    "delay": {
      "enabled": true,
      "feedback": 0.5,
      "mix": 0.4,
      "time_ms": 480.0
    },
    "distortion": {
      "drive": 0.3,
      "enabled": false,
      "level": 0.7,
      "tone": 0.5
    },
    "eq": {
      "enabled": true,
      "high_db": 3.0,
      "low_db": 0.0,
      "mid_db": 1.0
    },
    "input_gain": {
      "enabled": true,
      "gain_db": 0.0
    },
    "limiter": {
      "ceiling_db": -0.3,
      "enabled": true
    },
    "noise_gate": {
      "enabled": false,
      "threshold_db": -60.0
    },
    "overdrive": {
      "drive": 0.2,
      "enabled": false,
      "level": 0.8,
      "tone": 0.5
    },
    "reverb": {
      "decay": 0.85,
      "damping": 0.25,
      "enabled": true,
      "mix": 0.45
    }
  }
}
